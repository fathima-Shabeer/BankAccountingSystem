@model IEnumerable<BankAccountingSystem.WebApp.Models.JournalEntryLine>

@{
    ViewData["Title"] = "General Ledger";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="GeneralLedger" method="get" class="mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label for="accountId" class="form-label">Account</label>
            <select name="accountId" asp-items="ViewBag.Accounts" class="form-select">
                <option value="">-- All Accounts --</option>
            </select>
        </div>
        <div class="col-md-3">
            <label for="startDate" class="form-label">Start Date</label>
            <input type="date" name="startDate" value="@ViewData["StartDate"]" class="form-control" />
        </div>
        <div class="col-md-3">
            <label for="endDate" class="form-label">End Date</label>
            <input type="date" name="endDate" value="@ViewData["EndDate"]" class="form-control" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
        <div class="col-md-1">
            <a asp-action="GeneralLedger" class="btn btn-secondary w-100" title="Clear Filters">Clear</a>
        </div>
    </div>
</form>


<table class="table table-striped table-hover table-sm">
    <thead>
        <tr>
            <th>Date</th>
            <th>Account</th>
            <th>JE Ref</th>
            <th>Description</th>
            <th class="text-end">Debit</th>
            <th class="text-end">Credit</th>
            @* TODO: Add Running Balance column *@
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.JournalEntry?.EntryDate.ToString("yyyy-MM-dd")</td>
                <td>@item.Account?.AccountNumber - @item.Account?.Name</td>
                <td>
                    <a asp-controller="JournalEntries" asp-action="Details" asp-route-id="@item.JournalEntryId">
                        @item.JournalEntryId <!-- Or use ReferenceNumber if preferred -->
                    </a>
                </td>
                <td>@item.Description</td>
                <td class="text-end">@((item.DebitAmount > 0) ? item.DebitAmount.ToString("N2") : "")</td>
                <td class="text-end">@((item.CreditAmount > 0) ? item.CreditAmount.ToString("N2") : "")</td>
            </tr>
        }
    </tbody>
</table>